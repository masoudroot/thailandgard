{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "brief": {
      "type": "object",
      "properties": {
        "workItemId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "title": {
          "type": "string",
          "minLength": 10,
          "maxLength": 200
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "targetKeyword": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "audience": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "intent": {
          "type": "string",
          "enum": [
            "informational",
            "commercial",
            "transactional",
            "navigational"
          ]
        },
        "sourceFacts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 5
              },
              "source": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "claim",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "cta": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160
        }
      },
      "required": [
        "workItemId",
        "title",
        "slug",
        "targetKeyword",
        "audience",
        "intent",
        "sourceFacts",
        "cta"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 120
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "metaDescription": {
      "type": "string",
      "minLength": 70,
      "maxLength": 160
    },
    "bodyMarkdown": {
      "type": "string",
      "minLength": 500
    },
    "faq": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 5
          },
          "answer": {
            "type": "string",
            "minLength": 10
          }
        },
        "required": [
          "question",
          "answer"
        ],
        "additionalProperties": false
      }
    },
    "internalLinks": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 2
          },
          "href": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^\\/.*"
          }
        },
        "required": [
          "label",
          "href"
        ],
        "additionalProperties": false
      }
    },
    "cta": {
      "type": "string",
      "minLength": 5
    },
    "claims": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 5
          },
          "source": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "claim",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "wordCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "brief",
    "title",
    "slug",
    "metaDescription",
    "bodyMarkdown",
    "faq",
    "internalLinks",
    "cta",
    "claims",
    "wordCount"
  ],
  "additionalProperties": false
}
