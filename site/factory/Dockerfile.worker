FROM node:22-bookworm-slim

WORKDIR /app

ARG NPM_REGISTRY=https://registry.npmjs.org/

COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --omit=dev --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 --fetch-timeout=600000 --maxsockets=4 --registry="$NPM_REGISTRY" && chown -R node:node /app

ENV NODE_ENV=production

COPY --chown=node:node . .

USER node

CMD ["npm", "run", "factory:worker"]
