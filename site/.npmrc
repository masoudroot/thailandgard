# Dependency resolution for this project
#
# The Prisma Composer / vitest toolchain ships conflicting peer ranges
# (for example @effect/vitest wants effect ^4.0.3 while alchemy pins
# effect 4.0.0-rc.115). CI has always installed with --legacy-peer-deps;
# declaring it here makes plain `npm ci` reproducible locally, on Vercel
# and in GitHub Actions instead of depending on a remembered CLI flag.
legacy-peer-deps=true